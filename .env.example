# ---- Neon (Postgres) ----
# Neon console -> your project -> Connection string -> "Pooled connection"
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---- Cloudflare R2 ----
# Cloudflare dashboard -> R2 -> Overview (Account ID is in the right sidebar)
R2_ACCOUNT_ID="your-account-id"
R2_BUCKET="tisha"
# R2 -> Manage API tokens -> Create API token (Object Read & Write for this bucket)
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
# Optional. Leave empty to keep the bucket private and serve photos via
# short-lived presigned URLs. Set it only if you attach a custom domain to the
# bucket and are fine with the photos being publicly readable.
R2_PUBLIC_BASE_URL=""

# ---- Admin ----
# Anything you like. Changing it logs out every existing session.
ADMIN_PASSWORD="choose-something-long"

# ---- Telegram bot (optional) ----
# Upload by sending a photo *as a file* to the bot — bypasses Android's
# GPS-stripping photo picker entirely. @BotFather -> /newbot -> token.
TELEGRAM_BOT_TOKEN=""
# Your numeric Telegram user ID (e.g. from @userinfobot) — the bot ignores
# everyone else.
TELEGRAM_ALLOWED_USER_ID=""
# Any random string. Passed to setWebhook as secret_token; the bot rejects
# any request that doesn't echo it back in a header, so no one can POST
# fake updates at the webhook URL even if they find it.
TELEGRAM_WEBHOOK_SECRET=""

# ---- Umami analytics (optional) ----
# cloud.umami.is -> your website -> Settings -> Website ID. Leave empty to
# skip loading the tracking script entirely.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
